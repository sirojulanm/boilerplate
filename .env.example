# Copy this file to .env and replace the values. .env is gitignored.
PORT=1111
SERVICE_NAME=boilerplate
LOG_LEVEL=info
LOG_DIR=logs

# PostgreSQL credentials.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=boilerplate
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s
DB_AUTO_MIGRATE=false
# Optional full override; when set it wins over DB_* fields.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/boilerplate?sslmode=disable

# JWT settings. Generate a production secret with:
#   openssl rand -hex 32
JWT_ISSUER=boilerplate
JWT_AUDIENCE=boilerplate-api
JWT_TTL=1h
JWT_SECRET=change-me-with-openssl-rand-hex-32
